{
	"name": "libormatejka/clown-web",
	"description": "Minimální ukázkový web postavený na clown/core (Fáze 7 Krok B – test přenositelnosti Clown CMS)",
	"type": "project",
	"license": "proprietary",
	"require": {
		"php": ">=8.2",
		"clown/core": "dev-main",
		"clown/redirect": "dev-main",
		"contributte/console": "^0.10",
		"doctrine/dbal": "^4.0",
		"doctrine/migrations": "^3.8",
		"doctrine/orm": "^3.0",
		"latte/latte": "^3.1",
		"nette/application": "^3.2",
		"nette/bootstrap": "^3.2",
		"nette/caching": "^3.4",
		"nette/di": "^3.2",
		"nette/forms": "^3.2",
		"nette/http": "^3.3",
		"nette/robot-loader": "^4.0",
		"nette/security": "^3.2",
		"nette/utils": "^4.0",
		"nettrine/cache": "^0.3.0",
		"nettrine/dbal": "^0.10",
		"nettrine/migrations": "^0.10",
		"nettrine/orm": "^0.10",
		"symfony/console": "^6.4",
		"tracy/tracy": "^2.9",
		"ublaboo/datagrid": "^7.0"
	},
	"autoload": {
		"psr-4": {
			"App\\": "app"
		}
	},
	"minimum-stability": "stable",
	"config": {
		"allow-plugins": {}
	},
	"repositories": [
		{
			"type": "vcs",
			"url": "https://github.com/libormatejka/clown-core.git",
			"name": "clown/core"
		},
		{
			"type": "vcs",
			"url": "https://github.com/libormatejka/clown-redirect.git",
			"name": "clown/redirect"
		}
	]
}
