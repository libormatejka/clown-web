{block content}
{control headerBars $headerBarsValues}

<div class="px-4 sm:px-6 lg:px-8">
	<p class="mb-4 text-sm text-gray-500">Posledních {count($logs)} záznamů, nejnovější nahoře.</p>

	<div class="md:-my-2 md:-mx-4 overflow-x-auto sm:-mx-6 lg:-mx-8">
		<div class="block min-w-full py-2 align-middle md:px-6 lg:px-8">
			<table class="min-w-full divide-y divide-gray-300">
				<thead>
					<tr>
						<th scope="col" class="py-4 text-left text-sm font-semibold text-gray-900">Datum</th>
						<th scope="col" class="px-4 py-4 text-left text-sm font-semibold text-gray-900">Uživatel</th>
						<th scope="col" class="px-4 py-4 text-left text-sm font-semibold text-gray-900">Akce</th>
						<th scope="col" class="px-4 py-4 text-left text-sm font-semibold text-gray-900">Entita</th>
						<th scope="col" class="px-4 py-4 text-left text-sm font-semibold text-gray-900">IP adresa</th>
						<th scope="col" class="px-4 py-4 text-left text-sm font-semibold text-gray-900">Prohlížeč</th>
					</tr>
				</thead>
				<tbody class="divide-y divide-gray-200">
					{if count($logs) > 0}
						{foreach $logs as $log}
							<tr>
								<td class="whitespace-nowrap py-4 pr-3 text-sm text-gray-500">{$log->getPublishedAt()?->format('d.m.Y H:i:s') ?? '—'}</td>
								<td class="whitespace-nowrap px-4 py-4 text-sm text-gray-900">{$log->getUser()?->getEmail() ?? '—'}</td>
								<td class="px-4 py-4 text-sm font-medium text-gray-900">{$log->getLogType()->getText()}</td>
								<td class="whitespace-nowrap px-4 py-4 text-sm text-gray-500">{$log->getEntity()}{if $log->getEntityId() !== null} #{$log->getEntityId()}{/if}</td>
								<td class="whitespace-nowrap px-4 py-4 text-sm text-gray-500">{$log->getIpAddress() ?? '—'}</td>
								<td class="px-4 py-4 text-sm text-gray-500"><span class="block max-w-xs truncate" title="{$log->getUserAgent()}">{$log->getUserAgent() ?? '—'}</span></td>
							</tr>
						{/foreach}
					{else}
						<tr>
							<td colspan="6" class="text-center whitespace-nowrap py-4 pr-3 text-sm text-gray-500">Zatím žádné záznamy.</td>
						</tr>
					{/if}
				</tbody>
			</table>
		</div>
	</div>
</div>
{/block}
