<!DOCTYPE html>
<html lang="cs" class="h-full">
<head>
	<meta charset="utf-8">
	<meta name="viewport" content="width=device-width">
	<meta name="robots" content="noindex, nofollow">
	<title>Přihlášení | Clown Web</title>

	{if App\Bootstrap::loadAsset('admin.css') !== null}
		<link rel="stylesheet" href="{App\Bootstrap::getAsset('admin.css')}"/>
	{/if}
	{if App\Bootstrap::loadAsset('runtime.js') !== null}
		<script src="{App\Bootstrap::getAsset('runtime.js')}"></script>
	{/if}
	{if App\Bootstrap::loadAsset('admin.js') !== null}
		<script src="{App\Bootstrap::getAsset('admin.js')}"></script>
	{/if}
</head>
<body class="bg-gray-100 h-full">

	<div class="flex min-h-full items-center justify-center py-12 px-4 sm:px-6 lg:px-8">
		<div class="w-full max-w-lg space-y-8">
			<h2 class="mt-6 text-center text-3xl font-bold tracking-tight text-gray-900">Vítejte v administraci</h2>

			{control flashes $flashes}

			{control login}
		</div>
	</div>

	<script defer src="https://nette.github.io/resources/js/3/netteForms.min.js"></script>
</body>
</html>
