<!DOCTYPE html>
<html lang="cs" class="h-full bg-gray-100">
<head>
	{control metaTags}

	{if App\Bootstrap::loadAsset('admin.css') !== null}
		<link rel="stylesheet" href="{App\Bootstrap::getAsset('admin.css')}"/>
	{/if}
	{if App\Bootstrap::loadAsset('runtime.js') !== null}
		<script src="{App\Bootstrap::getAsset('runtime.js')}"></script>
	{/if}
	{if App\Bootstrap::loadAsset('admin.js') !== null}
		<script src="{App\Bootstrap::getAsset('admin.js')}"></script>
	{/if}
</head>

<body class="h-full bg-white">
	<div class="min-h-full">

		{control sidebar}

		<div class="flex flex-1 flex-col lg:pl-64 bg-white">
			<div class="flex h-16 shrink-0 border-b border-gray-200 bg-white lg:border-none">
				<div class="flex flex-1 justify-end px-4 sm:px-6 lg:px-8">
					<div class="ml-4 flex items-center gap-4 md:ml-6">
						<a n:href=":Front:Homepage:" target="_blank" class="text-sm text-gray-500 hover:text-gray-700">Zobrazit web</a>
						{control topBarProfile}
					</div>
				</div>
			</div>

			<main class="flex-1 pb-8">
				{include content}
			</main>
		</div>
	</div>
</body>
</html>
