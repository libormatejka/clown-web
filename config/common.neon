parameters:
	WEB:
		name: 'Clown Web'
		description: 'Minimální web postavený na Clown CMS (clown/core).'

	uploadsSettings:
		mediaLibraryDir: /media

	version:
		css: 0.1.0
		js: 0.1.0

	api:
		pepper: clown-web-dev-pepper-change-me

extensions:
	clownCore: Clown\Core\DI\ClownCoreExtension
	clownRedirect: Clown\Redirect\DI\ClownRedirectExtension
	clownBlocks: Clown\Blocks\DI\ClownBlocksExtension
	clownTaxonomy: Clown\Taxonomy\DI\ClownTaxonomyExtension
	clownLog: Clown\Log\DI\ClownLogExtension
	clownCache: Clown\Cache\DI\ClownCacheExtension
	clownRevisions: Clown\Revisions\DI\ClownRevisionsExtension
	clownFrontExtras: Clown\FrontExtras\DI\ClownFrontExtrasExtension
	clownGallery: Clown\Gallery\DI\ClownGalleryExtension
	clownArticles: Clown\Articles\DI\ClownArticlesExtension
	clownPortfolio: Clown\Portfolio\DI\ClownPortfolioExtension
	clownPodcast: Clown\Podcast\DI\ClownPodcastExtension
	clownBlog: Clown\Blog\DI\ClownBlogExtension
	clownPost: Clown\Post\DI\ClownPostExtension
	clownReviews: Clown\Reviews\DI\ClownReviewsExtension
	clownApi: Clown\Api\DI\ClownApiExtension
	clownWebMcp: Clown\WebMcp\DI\ClownWebMcpExtension
	clownGoogleAuth: Clown\GoogleAuth\DI\ClownGoogleAuthExtension

clownCore:
	templateOverrideDir: %appDir%/templates/override
	mediaLibraryDir: %uploadsSettings.mediaLibraryDir%
	webTitle: %WEB.name%
	pageLayouts:
		one-column: 'Jeden sloupec'
	wwwDir: %wwwDir%
	cssVersion: %version.css%
	jsVersion: %version.js%
	passwordAuthenticator: true

clownApi:
	pepper: %api.pepper%
	debugMode: %debugMode%

clownGoogleAuth:
	clientId: dev-placeholder-client-id
	clientSecret: dev-placeholder-client-secret
	redirectUri: http://localhost:8081/admin/login/google-callback

clownFrontExtras:
	gtmId: null
	structuredData:
		domain: https://clown-web.local
		defaultImage: /assets/img/placeholder.png
		uploadsDir: %uploadsSettings.mediaLibraryDir%
		license: https://clown-web.local/podminky/
		socialLinks: []
		websiteName: %WEB.name%
		websiteDescription: %WEB.description%
		organization:
			name: %WEB.name%
			description: 'Ukázkový web Clown CMS.'
			foundingDate: '2026'
			founderName: 'Clown Web'
			logoWidth: 512
			logoHeight: 512
			logoCaption: 'Clown Web logo'
			email: info@clown-web.local
			areaServed: CZ
			knowsAbout: []
		author:
			name: 'Clown Web'
			url: https://clown-web.local/
			email: info@clown-web.local
			jobTitle: Administrator
			street: ''
			locality: ''
			postalCode: ''
			region: CZ
			country: CZ
		publisher:
			name: %WEB.name%
			url: https://clown-web.local/
			description: %WEB.description%
			foundingDate: '2026'

application:
	errorPresenter: Front:Error
	mapping:
		*: [App\Module, *, *\*Presenter]

session:
	expiration: 14 days

di:
	export:
		parameters: no
		tags: no

services:
	cache.storage: Nette\Caching\Storages\FileStorage(%tempDir%/cache)
	cache: Nette\Caching\Cache(@cache.storage)
	- App\Router\RouterFactory::createRouter
	- App\Model\Service\AssetManifestResolver
	- App\Model\Command\SeedCommand

includes:
	- doctrine.neon
