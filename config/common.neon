parameters:
	WEB:
		name: 'Clown Web'
		description: 'Minimální web postavený na Clown CMS (clown/core).'

	uploadsSettings:
		mediaLibraryDir: /media

	version:
		css: 0.1.0
		js: 0.1.0

extensions:
	clownCore: Clown\Core\DI\ClownCoreExtension
	clownRedirect: Clown\Redirect\DI\ClownRedirectExtension
	clownBlocks: Clown\Blocks\DI\ClownBlocksExtension
	clownTaxonomy: Clown\Taxonomy\DI\ClownTaxonomyExtension
	clownLog: Clown\Log\DI\ClownLogExtension
	clownCache: Clown\Cache\DI\ClownCacheExtension
	clownRevisions: Clown\Revisions\DI\ClownRevisionsExtension

clownCore:
	templateOverrideDir: %appDir%/templates/override
	mediaLibraryDir: %uploadsSettings.mediaLibraryDir%
	webTitle: %WEB.name%
	pageLayouts:
		one-column: 'Jeden sloupec'
	wwwDir: %wwwDir%
	cssVersion: %version.css%
	jsVersion: %version.js%
	passwordAuthenticator: true

application:
	errorPresenter: Front:Error
	mapping:
		*: [App\Module, *, *\*Presenter]

session:
	expiration: 14 days

di:
	export:
		parameters: no
		tags: no

services:
	cache.storage: Nette\Caching\Storages\FileStorage(%tempDir%/cache)
	cache: Nette\Caching\Cache(@cache.storage)
	- App\Router\RouterFactory::createRouter
	- App\Model\Service\AssetManifestResolver
	- App\Model\Command\SeedCommand

includes:
	- doctrine.neon
