parameters:
	WEB:
		name: 'Clown Web'
		description: 'Minimální web postavený na Clown CMS (clown/core).'

	uploadsSettings:
		mediaLibraryDir: /media
		mediaLibraryPath: %wwwDir%/media

	ai:
		apiKey: dev-placeholder-gemini-api-key
		imageApiKey: dev-placeholder-gemini-image-api-key

	version:
		css: 0.1.0
		js: 0.1.0

	api:
		pepper: clown-web-dev-pepper-change-me

extensions:
	clownCore: Clown\Core\DI\ClownCoreExtension
	clownRedirect: Clown\Redirect\DI\ClownRedirectExtension
	clownBlocks: Clown\Blocks\DI\ClownBlocksExtension
	clownTaxonomy: Clown\Taxonomy\DI\ClownTaxonomyExtension
	clownLog: Clown\Log\DI\ClownLogExtension
	clownCache: Clown\Cache\DI\ClownCacheExtension
	clownRevisions: Clown\Revisions\DI\ClownRevisionsExtension
	clownFrontExtras: Clown\FrontExtras\DI\ClownFrontExtrasExtension
	clownGallery: Clown\Gallery\DI\ClownGalleryExtension
	clownArticles: Clown\Articles\DI\ClownArticlesExtension
	clownPortfolio: Clown\Portfolio\DI\ClownPortfolioExtension
	clownPodcast: Clown\Podcast\DI\ClownPodcastExtension
	clownBlog: Clown\Blog\DI\ClownBlogExtension
	clownPost: Clown\Post\DI\ClownPostExtension
	clownReviews: Clown\Reviews\DI\ClownReviewsExtension
	clownApi: Clown\Api\DI\ClownApiExtension
	clownWebMcp: Clown\WebMcp\DI\ClownWebMcpExtension
	clownGoogleAuth: Clown\GoogleAuth\DI\ClownGoogleAuthExtension
	clownAi: Clown\Ai\DI\ClownAiExtension

clownCore:
	templateOverrideDir: %appDir%/templates/override
	mediaLibraryDir: %uploadsSettings.mediaLibraryDir%
	webTitle: %WEB.name%
	pageLayouts:
		one-column: 'Jeden sloupec'
	wwwDir: %wwwDir%
	cssVersion: %version.css%
	jsVersion: %version.js%
	passwordAuthenticator: true

clownApi:
	pepper: %api.pepper%
	debugMode: %debugMode%

clownGoogleAuth:
	clientId: dev-placeholder-client-id
	clientSecret: dev-placeholder-client-secret
	redirectUri: http://localhost:8081/admin/login/google-callback

clownAi:
	apiKey: %ai.apiKey%
	imageApiKey: %ai.imageApiKey%

clownFrontExtras:
	gtmId: null
	structuredData:
		domain: https://clown-web.local
		defaultImage: /assets/img/placeholder.png
		uploadsDir: %uploadsSettings.mediaLibraryDir%
		license: https://clown-web.local/podminky/
		socialLinks: []
		websiteName: %WEB.name%
		websiteDescription: %WEB.description%
		organization:
			name: %WEB.name%
			description: 'Ukázkový web Clown CMS.'
			foundingDate: '2026'
			founderName: 'Clown Web'
			logoWidth: 512
			logoHeight: 512
			logoCaption: 'Clown Web logo'
			email: info@clown-web.local
			areaServed: CZ
			knowsAbout: []
		author:
			name: 'Clown Web'
			url: https://clown-web.local/
			email: info@clown-web.local
			jobTitle: Administrator
			street: ''
			locality: ''
			postalCode: ''
			region: CZ
			country: CZ
		publisher:
			name: %WEB.name%
			url: https://clown-web.local/
			description: %WEB.description%
			foundingDate: '2026'

application:
	errorPresenter: Front:Error
	mapping:
		*: [App\Module, *, *\*Presenter]

session:
	expiration: 14 days

di:
	export:
		parameters: no
		tags: no

services:
	cache.storage: Nette\Caching\Storages\FileStorage(%tempDir%/cache)
	cache: Nette\Caching\Cache(@cache.storage)
	- App\Router\RouterFactory::createRouter
	- App\Model\Service\AssetManifestResolver
	- App\Model\Command\SeedCommand

	# AiPresenter (Clown\Ai) má mediaLibraryDir typovaný přes
	# Clown\Core\Settings\MediaLibraryDir (autowireable), ale
	# mediaLibraryPath zůstává syrový string parametr (core pro něj
	# žádný typový obal nemá) — web ho musí zaregistrovat jako
	# explicitní službu jen s tímto jedním argumentem (viz
	# docs/CMS_CORE_MIGRATION_PLAN.md, B9).
	- App\Module\Admin\Ai\AiPresenter(mediaLibraryPath: %uploadsSettings.mediaLibraryPath%)

	# Routa pro site-specific per-content API presentery (TinyMCE shortcode
	# tlačítka), viz docs/CMS_CORE_MIGRATION_PLAN.md, B10.
	-
		factory: App\Router\ContentApiRouteFactory
		tags: [clown.route]

	# Content providery se registrují přes tag clown.contentProvider — registr
	# je sestavuje ClownCoreExtension. Stejné instance jsou navíc tagované
	# clown.taggable (TaggableRegistry — počty použití štítku v Admin:Tag).
	# Bez tohoto zápisu by Front:Preview pro tyto typy vracel "nejsou na tomto
	# webu nainstalované" (viz docs/CMS_CORE_MIGRATION_PLAN.md, Previewable).
	-
		factory: Clown\Core\ContentProvider\GenericContentProvider('Article', 'Článek', Clown\Articles\Entity\Article, Clown\Articles\Entity\ArticleTag, 'article', true)
		tags: [clown.contentProvider, clown.taggable]
	-
		factory: Clown\Core\ContentProvider\GenericContentProvider('Post', 'Příspěvek', Clown\Post\Entity\Post, Clown\Post\Entity\PostTag, 'post', true)
		tags: [clown.contentProvider, clown.taggable]
	-
		factory: Clown\Core\ContentProvider\GenericContentProvider('Review', 'Recenze', Clown\Reviews\Entity\Review, Clown\Reviews\Entity\ReviewTag, 'review', true)
		tags: [clown.contentProvider, clown.taggable]
	-
		factory: Clown\Core\ContentProvider\GenericContentProvider('Portfolio', 'Portfolio', Clown\Portfolio\Entity\Portfolio, Clown\Portfolio\Entity\PortfolioTag, 'portfolio', false)
		tags: [clown.contentProvider, clown.taggable]
	-
		factory: Clown\Core\ContentProvider\GenericContentProvider('Podcast', 'Podcast', Clown\Podcast\Entity\Podcast, Clown\Podcast\Entity\PodcastTag, 'podcast', true)
		tags: [clown.contentProvider, clown.taggable]
	-
		factory: Clown\Core\ContentProvider\GenericContentProvider('Blog', 'Příspěvek na blogu', Clown\Blog\Entity\Blog, Clown\Blog\Entity\BlogTag, 'blog', true)
		tags: [clown.contentProvider, clown.taggable]
	-
		factory: Clown\Core\ContentProvider\GenericContentProvider('Gallery', 'Fotogalerie', Clown\Gallery\Entity\Gallery, Clown\Gallery\Entity\GalleryTag, 'gallery', false)
		tags: [clown.contentProvider, clown.taggable]

includes:
	- doctrine.neon
